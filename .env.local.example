NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Booking confirmation SMS (optional -- app works fine without these,
# it just skips sending). NEVER prefix these with NEXT_PUBLIC_: unlike
# the Supabase anon key, these are real secrets and must stay server-only.
